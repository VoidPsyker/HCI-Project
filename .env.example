# Server
PORT=8787
# Required: set a unique password before starting the server or Docker Compose.
ADMIN_PASSWORD=
STUDY_SEED=meridian-pilot-2026
DATABASE_PATH=./data/meridian.sqlite
RAW_DATA_DIR=./data/raw
GAZE_DATA_DIR=./data/gaze

# Container role: false on the persistent study server, true on the Vercel proxy.
MERIDIAN_VERCEL_PROXY=false
# Required only on the Vercel proxy: HTTPS origin, no path or credentials.
STUDY_BACKEND_ORIGIN=

# Web (Vite). Public build-time setting; never put secrets here.
# Leave VITE_API_BASE empty to use the same origin / proxy.
VITE_API_BASE=

# Out of pilot scope; the server refuses to start if either is true.
FEATURE_STUDY2=false
FEATURE_STUDY3=false
